# Research data and generated artifacts (retain directory placeholders)
data/**/*
!data/**/
!data/**/.gitkeep
!data/external/*.csv
!data/external/README.md
# Original papers are local review inputs and must never be committed.
data/raw/papers/*.pdf
!data/raw/papers/README.md
!data/raw/papers/paper_manifest.csv
!data/interim/scientific_data_recovery.csv
!data/schema/feature_schema_v1.csv
!data/schema/feature_sets_v1.csv
!data/schema/feature_priority_v1.csv
!data/schema/domain_manifest_v1.csv
!data/splits/split_candidates_v1.csv
!data/splits/split_manifest_v1.csv
!data/processed/master_19papers_recovery_v2.csv
!data/processed/master_19papers_recovery_v3.csv
!data/processed/master_19papers_recovery_v4.csv
models/trained/**/*
!models/trained/**/
!models/trained/.gitkeep
models/checkpoints/**/*
!models/checkpoints/**/
!models/checkpoints/.gitkeep
results/**/*
!results/**/
!results/**/.gitkeep
figures/**/*
!figures/**/
